# ============================================================
# SaaS «AI-Администратор» — переменные окружения
# Скопируйте в .env:  cp .env.example .env   и заполните секреты.
# ============================================================

# --- Общее ---
APP_ENV=prod                 # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=true

# --- Безопасность (ОБЯЗАТЕЛЬНО сменить перед запуском) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_random_string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ротация ключей: новый ключ ПЕРВЫМ в списке, старые — дальше (для расшифровки).
FERNET_KEYS=CHANGE_ME_fernet_key

# --- Инфраструктура ---
POSTGRES_USER=aiadmin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=aiadmin
HTTP_PORT=80
# Внутри Compose хосты postgres/redis; для локальной разработки — localhost:5433/6380
DATABASE_URL=postgresql://aiadmin:CHANGE_ME_strong_password@postgres:5432/aiadmin
REDIS_URL=redis://redis:6379/0

# --- Домен ---
RETENTION_DAYS=90            # хранение переписки (152-ФЗ)
LLM_PROVIDER=gigachat        # gigachat | yandexgpt
EMBEDDING_DIM=1024
TIMEZONE=Europe/Moscow
CORS_ORIGINS=http://localhost:3000
